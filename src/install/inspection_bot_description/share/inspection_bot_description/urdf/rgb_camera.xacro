<?xml version="1.0"?>
<!--
  À inclure dans le xacro du TurtleBot3 si tu utilises le modèle "burger"
  (qui n'a pas de caméra par défaut). Le modèle "waffle_pi" a déjà une
  caméra RGB Raspberry Pi intégrée sur le topic /camera/image_raw — dans
  ce cas, ce fichier n'est pas nécessaire, il suffit de :
      export TURTLEBOT3_MODEL=waffle_pi
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="inspection_camera_link">
    <visual>
      <geometry><box size="0.03 0.03 0.03"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
  </link>

  <joint name="inspection_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="inspection_camera_link"/>
    <origin xyz="0.08 0 0.12" rpy="0 0 0"/>
  </joint>

  <gazebo reference="inspection_camera_link">
    <sensor type="camera" name="inspection_camera">
      <update_rate>15.0</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>20</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
          <remapping>image_raw:=camera/image_raw</remapping>
          <remapping>camera_info:=camera/camera_info</remapping>
        </ros>
        <camera_name>inspection_camera</camera_name>
        <frame_name>inspection_camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
