<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="server_room">

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- ============================================================= -->
    <!-- Murs extérieurs de la salle serveur (10m x 8m)                 -->
    <!-- ============================================================= -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1.25 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.2 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_west_1">
      <!-- Mur ouest avec une ouverture (porte automatique) au milieu -->
      <static>true</static>
      <pose>-5 -2.25 1.25 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.5 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.5 0.2 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name="wall_west_2">
      <static>true</static>
      <pose>-5 2.25 1.25 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.5 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.5 0.2 2.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Porte "automatique" : modèle statique simple, ouverte.
         Pour l'animer (ouverture/fermeture), ajouter un plugin
         gazebo_ros_joint_state_publisher + un joint prismatique. -->
    <model name="server_room_door">
      <static>true</static>
      <pose>-5 0 1.0 0 0 1.5708</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.4 0.05 2.0</size></box></geometry>
          <material><ambient>0.2 0.5 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================= -->
    <!-- Macro-like racks : 3 rangées x 4 racks = 12 racks              -->
    <!-- Couloirs entre les rangées pour laisser passer le robot        -->
    <!-- ============================================================= -->
    <!-- Rangée 1 : y = 2.5 -->
    <model name="rack_1_1"><static>true</static><pose>-3 2.5 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.8 1.0 1.8</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.8 1.0 1.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient></material></visual></link>
    </model>
    <model name="rack_1_2"><static>true</static><pose>-1 2.5 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.8 1.0 1.8</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.8 1.0 1.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient></material></visual></link>
    </model>
    <model name="rack_1_3"><static>true</static><pose>1 2.5 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.8 1.0 1.8</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.8 1.0 1.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient></material></visual></link>
    </model>
    <model name="rack_1_4"><static>true</static><pose>3 2.5 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.8 1.0 1.8</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.8 1.0 1.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient></material></visual></link>
    </model>

    <!-- Rangée 2 : y = 0 -->
    <model name="rack_2_1"><static>true</static><pose>-3 0 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.8 1.0 1.8</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.8 1.0 1.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient></material></visual></link>
    </model>
    <model name="rack_2_2"><static>true</static><pose>-1 0 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.8 1.0 1.8</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.8 1.0 1.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient></material></visual></link>
    </model>
    <model name="rack_2_3"><static>true</static><pose>1 0 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.8 1.0 1.8</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.8 1.0 1.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient></material></visual></link>
    </model>
    <model name="rack_2_4"><static>true</static><pose>3 0 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.8 1.0 1.8</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.8 1.0 1.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient></material></visual></link>
    </model>

    <!-- Rangée 3 : y = -2.5 -->
    <model name="rack_3_1"><static>true</static><pose>-3 -2.5 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.8 1.0 1.8</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.8 1.0 1.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient></material></visual></link>
    </model>
    <model name="rack_3_2"><static>true</static><pose>-1 -2.5 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.8 1.0 1.8</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.8 1.0 1.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient></material></visual></link>
    </model>
    <model name="rack_3_3"><static>true</static><pose>1 -2.5 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.8 1.0 1.8</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.8 1.0 1.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient></material></visual></link>
    </model>
    <model name="rack_3_4"><static>true</static><pose>3 -2.5 0.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.8 1.0 1.8</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.8 1.0 1.8</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient></material></visual></link>
    </model>

    <!-- ============================================================= -->
    <!-- Voyants rouges collés sur quelques racks (cibles de détection) -->
    <!-- Décale-les / active-les au hasard pour créer des "anomalies"   -->
    <!-- ============================================================= -->
    <model name="red_led_rack_1_3">
      <static>true</static>
      <pose>1 3.0 1.3 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <material><ambient>1 0 0 1</ambient><emissive>1 0 0 1</emissive></material>
        </visual>
      </link>
    </model>

    <model name="red_led_rack_2_4">
      <static>true</static>
      <pose>3 0.5 1.3 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <material><ambient>1 0 0 1</ambient><emissive>1 0 0 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- Zone chaude simulée (juste un marquage visuel au sol, rouge translucide) -->
    <model name="hot_zone_marker">
      <static>true</static>
      <pose>2 2.5 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.2 1.2 0.01</size></box></geometry>
          <material><ambient>1 0.3 0.1 0.4</ambient></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
