# Une anomalie détectée par la couche vision pendant l'inspection.

string anomaly_type        # "red_led", "open_rack_door", "disconnected_cable", "smoke"
string rack_id             # ex: "rack_2_4"
float32 confidence         # 0.0 - 1.0
bool critical              # true => le robot doit revenir dessus en priorité
geometry_msgs/Pose robot_pose
string image_path          # chemin de la photo prise au moment de la détection
builtin_interfaces/Time stamp
